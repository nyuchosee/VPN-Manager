# Заполняется только на сервере, НЕ публиковать и НЕ отправлять в чат.
# Токен нового бота @BotFather (не штатного бота уведомлений 3x-ui).
TELEGRAM_BOT_TOKEN=CHANGE_ME
# Цифровой Telegram ID администратора; несколько — через запятую.
ADMIN_IDS=123456789
# Существующий HTTPS URL панели с нужным nginx base path, БЕЗ /panel/api/...
XUI_URL=https://panel.example.org/secret-panel-prefix
XUI_API_TOKEN=CHANGE_ME
# Несколько действующих Inbound через запятую; ID приведены только для примера.
# Список влияет на новых клиентов, существующие привязки не меняются.
INBOUND_IDS=1,2
# Скопируйте реальную ссылку подписки из 3x-ui, замените только настоящий subId на {sub_id}.
# Не копируйте саму реальную ссылку в чат.
SUBSCRIPTION_URL_TEMPLATE=https://sub.example.org/sub/{sub_id}
# Критически важно: сначала false. Включать true только после тестов и бэкапа.
WRITE_ENABLED=false
# Не отключать проверку TLS; оставлено только для диагностики в контролируемой среде.
INSECURE_SKIP_TLS_VERIFY=false
DATABASE_PATH=/var/lib/vpn-bot/bot.sqlite3
HTTP_TIMEOUT=15
